prod:
  driver: "postgres"
  host: "127.0.0.1"
  port: 5432
  user: "postgres"
  password: "password"
  database: "prod_db"

dev:
  driver: "postgres"
  host: "127.0.0.1"
  port: 5432
  user: "postgres"
  password: "password"
  database: "dev_db"

ignore:
  tables:
    - "logs"
    - "audit"
  columns:
    - "*.updated_at"

output:
  dir: "./diff-output"

# Conflict resolution settings (optional)
# Used by the resolve-conflicts and gen-pack commands
conflict_resolution:
  # Default strategy for all conflicts: "ours", "theirs", or "manual"
  # - ours: Keep production values (reject dev changes)
  # - theirs: Use development values (accept dev changes)
  # - manual: Require interactive decision for each conflict
  default_strategy: "manual"

  # Table-specific strategies (overrides default_strategy)
  strategies:
    # Example: Always keep production data for certain tables
    # - table: "users"
    #   strategy: "ours"

    # Example: Always accept dev changes for feature flags
    # - table: "feature_flags"
    #   strategy: "theirs"

    # Example: Require manual review for orders
    # - table: "orders"
    #   strategy: "manual"

# Performance settings for large-dataset operations (optional)
# Tune these when comparing tables with millions of rows.
performance:
  # Number of rows fetched per keyset-paginated query during table hashing.
  # Lower values reduce peak memory usage; higher values reduce round-trips.
  # Set to 0 to load the entire table in one query (default behaviour pre-v0.7).
  # Default: 10000
  # hash_batch_size: 10000

  # Maximum number of tables hashed concurrently.
  # Increasing this can cut wall-clock time on multi-core hosts but uses more
  # database connections and memory in parallel.
  # Default: 1 (sequential — safest for all environments)
  # max_parallel_tables: 1
